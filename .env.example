# ---------------------------------------------------------------
# TranZip - runtime configuration for the API proxy server + web app.
# Copy to `.env` and fill in your own credentials:
#   cp .env.example .env
# See README.md for where to get each key.
# ---------------------------------------------------------------

# Port for the Express API proxy (Vite dev server proxies /api here)
PORT=8787

# --- Required ---------------------------------------------------

# LTA DataMall AccountKey (https://datamall.lta.gov.sg) - register, then
# request a key by email; it usually arrives within minutes.
# Sent as the `AccountKey` header on every datamall2.mytransport.sg call.
# Powers: bus arrivals + load, MRT/LRT platform crowd, service alerts, and
# the LTA-native fallback planner (bus routes + rail topology).
LTA_ACCOUNT_KEY=

# OneMap access token (JWT, nominally valid ~72h) from
# https://www.onemap.gov.sg/apidocs/register. Sent as `Authorization: Bearer
# <token>`. Powers: place search, reverse geocoding, and (when its routing
# service is enabled for your token) turn-by-turn transit routing.
ONEMAP_TOKEN=

# Optional but recommended: OneMap account credentials. When both are set,
# the server mints a fresh token itself via POST /api/auth/post/getToken
# whenever the current one is rejected or near expiry, so the app keeps
# working past OneMap's 3-day token lifetime without a manual token refresh.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Optional -----------------------------------------------------

# Set to 1 to enable the in-app "Demo: simulate NEL disruption (Punggol
# area)" switch (see server/data/test-overrides.js for the fixture and
# server/lib/disruptions.js for the toggle). Off (unset) by default so a
# real deployment never ships with a fake-disruption switch in the UI - the
# toggle isn't just disabled when this is unset, it's absent from the page
# entirely.
DEMO_MODE=0

# Google Maps Routes API key
# (https://developers.google.com/maps/documentation/routes) - entirely
# optional. When unset (or left as the placeholder below), the app falls
# back to OneMap routing, and from there to the LTA-native planner, so it
# still works end-to-end on LTA + OneMap credentials alone.
# Sent as `X-Goog-Api-Key` to routes.googleapis.com/directions/v2:computeRoutes.
GOOGLE_MAPS_API_KEY=YOUR_API_KEY

# Basemap tiles - OpenStreetMap, no API key. These are VITE_-prefixed, so Vite
# reads them and ships them to the browser: only ever put a *public* tile
# URL/attribution string here, never a secret.
# Default: OSM's own tile server. Its usage policy
# (https://operations.osmfoundation.org/policies/tiles/) is for light use: keep
# the "OpenStreetMap contributors" credit on the map (it is), don't bulk
# download or pre-fetch tiles, and note OSM can block heavy traffic without
# notice and offers no uptime guarantee. Fine for a demo; for real traffic
# switch to a provider below. These tiles are also never cached offline.
#
# Alternatives (set both vars, and credit the provider as well as OpenStreetMap):
#   CARTO Voyager - free key, no account, https://carto.com/basemaps/apikey
#     VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_KEY
#     (without the key CARTO stamps an "API KEY REQUIRED" watermark on every tile)
#   MapTiler - free key, https://cloud.maptiler.com
#     VITE_TILE_URL=https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors

# --- Server-side cache TTLs (milliseconds) - tune down for demoing live
# changes faster, or leave at the defaults ------------------------

CACHE_TTL_REFERENCE_MS=86400000
CACHE_TTL_BUS_ARRIVAL_MS=20000
CACHE_TTL_CROWD_MS=60000
CACHE_TTL_CROWD_FORECAST_MS=1800000
CACHE_TTL_ALERTS_MS=60000
CACHE_TTL_ROUTE_MS=45000
CACHE_TTL_WEATHER_MS=300000
# "Today" advice for a saved usual trip (POST /api/journey/window)
CACHE_TTL_WINDOW_MS=45000

# Timeout for every outbound LTA/OneMap/Google/weather request (milliseconds)
REQUEST_TIMEOUT_MS=20000

# Advanced/deployment only: where `npm run dev`'s Vite dev server proxies
# /api requests to. Not read from this .env file (it's a plain shell var for
# vite.config.js), only listed here for completeness. Leave unset for normal
# local dev - it defaults to http://localhost:PORT.
# API_TARGET=http://localhost:8787
