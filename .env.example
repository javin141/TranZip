# ---------------------------------------------------------------
# NebulaX Transit - runtime configuration for the API proxy server
# Copy to `.env` and fill in your own credentials.
# ---------------------------------------------------------------

# Port for the Express API proxy (Vite dev server proxies /api here)
PORT=8787

# LTA DataMall AccountKey (https://datamall.lta.gov.sg)
# Sent as the `AccountKey` header on every datamall2.mytransport.sg call.
LTA_ACCOUNT_KEY=

# OneMap access token (JWT, valid ~72h) from https://www.onemap.gov.sg/apidocs/register
# Sent as `Authorization: Bearer <token>`.
ONEMAP_TOKEN=

# Optional: OneMap account credentials. When both are set the server mints a
# fresh token via POST /api/auth/post/getToken before the JWT expires, so the
# app keeps working past the 3-day token lifetime.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Server-side cache TTLs (milliseconds)
CACHE_TTL_REFERENCE_MS=86400000
CACHE_TTL_BUS_ARRIVAL_MS=20000
CACHE_TTL_CROWD_MS=60000
CACHE_TTL_CROWD_FORECAST_MS=1800000
CACHE_TTL_ALERTS_MS=60000
CACHE_TTL_ROUTE_MS=45000